# Optional overrides for any OpenAI-compatible vision server.
# The built-in endpoint remains http://localhost:1234/v1.
# LLM_API_BASE=http://localhost:1234/v1

# Without an override, every mode uses lightonai/LightOnOCR-3-4B.
# An override applies to every mode;
# use the exact model ID advertised by your server.
# LLM_MODEL=your-served-vision-model

# Optional model conventions when using a server alias; otherwise auto-detected.
# LLM_MODEL_PROFILE=lightonocr-3

# Optional bearer authentication. Keep credentials in your local .env.
# LLM_API_KEY=your-server-key
