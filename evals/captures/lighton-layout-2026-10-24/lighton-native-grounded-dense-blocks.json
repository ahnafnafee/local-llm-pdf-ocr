{
  "blocks": [
    {
      "bbox": [
        0.0035764705882352947,
        0.004298181818181818,
        0.06366117647058823,
        0.015043636363636365
      ],
      "text": "- for example:",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.015043636363636365,
        0.09370352941176471,
        0.025789090909090907
      ],
      "text": "$R = \\{A, B, C, D, E, \\hat{A}\\}$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.025789090909090907,
        0.16523294117647058,
        0.03653454545454545
      ],
      "text": "$FDs: AB \\rightarrow C, \\quad D \\rightarrow AD, \\quad D \\rightarrow E, \\quad CE \\rightarrow B$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.03653454545454545,
        0.06366117647058823,
        0.04728
      ],
      "text": "$\\therefore \\{A, B\\}^+ ?$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.05444363636363636,
        0.06366117647058823,
        0.0651890909090909
      ],
      "text": "- build a Snowball...",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.0651890909090909,
        0.24248470588235294,
        0.22278909090909088
      ],
      "text": "<table>\n  <tr>\n    <th>Round</th>\n    <th>a. Snowball</th>\n    <th>Snowball</th>\n  </tr>\n  <tr>\n    <td>Start</td>\n    <td>A and B</td>\n    <td> $\\{A, B\\}$ </td>\n  </tr>\n  <tr>\n    <td>1</td>\n    <td> $AB \\rightarrow C$ </td>\n    <td> $\\{A, B, C\\}$ </td>\n  </tr>\n  <tr>\n    <td>2</td>\n    <td> $BC \\rightarrow AD$ </td>\n    <td> $\\{A, B, C, D\\}$ </td>\n  </tr>\n  <tr>\n    <td>3</td>\n    <td> $D \\rightarrow E$ </td>\n    <td> $\\{A, B, C, E\\}$ </td>\n  </tr>\n  <tr>\n    <td>4</td>\n    <td>X</td>\n    <td>Done</td>\n  </tr>\n</table>",
      "page_index": 1,
      "label": "table"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.22278909090909088,
        0.16523294117647058,
        0.23353454545454544
      ],
      "text": "$\\therefore \\{A, B\\}^+ = \\{A, B, C, D, E\\}$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.07939764705882353,
        0.23353454545454544,
        0.16523294117647058,
        0.24428
      ],
      "text": "*Gives new redundancy*",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.0035764705882352947,
        0.28009818181818186,
        0.16523294117647058,
        0.2908436363636364
      ],
      "text": "- 2NF (Second Normal Form)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.008596363636363636,
        0.4513819607843137,
        0.016476363636363636
      ],
      "text": "- what about $\\mathcal{E}(C, D)^+$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.018983636363636362,
        0.4513819607843137,
        0.02686363636363636
      ],
      "text": "$\\mathcal{E}(C, D)^+ \\Rightarrow \\mathcal{E}(C, D)$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.41310745098039214,
        0.028296363636363637,
        0.4513819607843137,
        0.03617636363636364
      ],
      "text": "$D \\rightarrow E$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.41310745098039214,
        0.03689272727272727,
        0.4513819607843137,
        0.04477272727272727
      ],
      "text": "$\\Rightarrow \\mathcal{E}(C, D, E)$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.41310745098039214,
        0.04548909090909091,
        0.4513819607843137,
        0.05372727272727272
      ],
      "text": "$C \\rightarrow D$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.41310745098039214,
        0.05408545454545455,
        0.4513819607843137,
        0.061965454545454546
      ],
      "text": "$\\Rightarrow \\mathcal{E}(D, C, D, E)$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.41310745098039214,
        0.06268181818181819,
        0.4513819607843137,
        0.07056181818181818
      ],
      "text": "$B \\rightarrow A$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.41310745098039214,
        0.07092,
        0.4513819607843137,
        0.07880000000000001
      ],
      "text": "$\\Rightarrow \\mathcal{E}(A, B, C, D, E)$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.4513819607843137,
        0.08023272727272728,
        0.5087937254901961,
        0.08811272727272727
      ],
      "text": "$G$ still missing",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.4513819607843137,
        0.08882909090909091,
        0.5470682352941176,
        0.09670909090909093
      ],
      "text": "$\\therefore \\mathcal{E}(C, D)$ is NOT a candidate key",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.09814181818181819,
        0.5470682352941176,
        0.10602181818181818
      ],
      "text": "$\\Rightarrow \\mathcal{E}(C, D, G)^+ = \\mathcal{E}(A, B, C, D, E, G)$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.10745454545454544,
        0.5470682352941176,
        0.11533454545454545
      ],
      "text": "$G$ is a superkey since it covers all attributes in $R$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.1160509090909091,
        0.5470682352941176,
        0.12393090909090909
      ],
      "text": "$G$ is a candidate key too since is minimal \u2014 removing $G$ breaks the SIK property.",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.12536363636363637,
        0.4513819607843137,
        0.13324363636363637
      ],
      "text": "same applies for:",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.13396,
        0.4513819607843137,
        0.14184
      ],
      "text": "$\\mathcal{E}(A, B, G)^+$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.3556956862745098,
        0.14327272727272727,
        0.4513819607843137,
        0.15115272727272727
      ],
      "text": "$\\therefore$ After 2NF $\\rightarrow$ 3NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.008596363636363636,
        0.7412125490196079,
        0.02220727272727273
      ],
      "text": "# Normalization",
      "page_index": 1,
      "label": "title"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.02292363636363636,
        0.9204282352941177,
        0.06232363636363636
      ],
      "text": "- 1NF: dissolves multi-valued attributes. composite atts, and new combinations",
      "page_index": 1,
      "label": "list"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.06232363636363636,
        0.9204282352941177,
        0.1160509090909091
      ],
      "text": "- Prime vs. Nonprime Atts\n  - $\\downarrow$ number of any candidate key\n  - $\\downarrow$ not a prime att. (not a member of any c.k.)",
      "page_index": 1,
      "label": "list"
    },
    {
      "bbox": [
        0.7949772549019608,
        0.1160509090909091,
        0.8458745098039215,
        0.12966181818181818
      ],
      "text": "$\\downarrow$ disjoint",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.12966181818181818,
        0.9204282352941177,
        0.16906181818181817
      ],
      "text": "- Full FD vs. Partial FD\n  - $\\downarrow$ removing a single attr breaks the dependency\n  - $\\downarrow$ removing some attr and dep still holds",
      "page_index": 1,
      "label": "list"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.16906181818181817,
        0.9204282352941177,
        0.1830309090909091
      ],
      "text": "e.g. EMP-PROS(SSN, Pname, Maws, Ename)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.1830309090909091,
        0.9204282352941177,
        0.21061090909090907
      ],
      "text": "$\\rightarrow$ SSN, Pname/3 \u2192 Maws : full FD (need both to obtain Maws value)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.21061090909090907,
        0.9204282352941177,
        0.2385490909090909
      ],
      "text": "$\\rightarrow$ SSN, Pname/3 \u2192 Ename : partial FD (SSN alone determines Ename)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.2385490909090909,
        0.9204282352941177,
        0.2525181818181818
      ],
      "text": "e.g.",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.6784870588235294,
        0.2525181818181818,
        0.9204282352941177,
        0.26648727272727274
      ],
      "text": "$\\rightarrow$ SSN, Pname, and Mname/3 \u2192 Ename",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.012,
        0.3508460606060606,
        0.248,
        0.4122278787878788
      ],
      "text": "- 2NF (Second Normal Form)\n  - already in 1NF\n  - every nonprime attr is fully FD on primary key",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.012,
        0.4160642424242424,
        0.248,
        0.5081369696969696
      ],
      "text": "\u2234 for 1NF \u2192 2NF\n  - find every partial dependencies\n  - move attr and partial key to new, sep table relation\n  - as partial dependencies cause redundancies",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.012,
        0.5119733333333334,
        0.248,
        0.6232278787878788
      ],
      "text": "e.g. EMP-PROJ(SSN, Pnumber, Name, Ename, Phone, Plocation) FD1: SSN, Pnumber \u2192 Name (full) FD2: SSN \u2192 Ename (partial) - ename depends only on SSN FD3: Pnumber \u2192 Phone, Plocation (partial) - they depend on Pnumber",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.012,
        0.6270642424242424,
        0.248,
        0.6731006060606061
      ],
      "text": "- BCNF (Boyce-Codd Normal Form)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.472,
        0.3508460606060606,
        0.622,
        0.4122278787878788
      ],
      "text": "After 2NF \u2192 3 tables EP1 (SSN, Pnumber, Name) - full dep EP2 (SSN, Ename) - employee details EP3 (Pnumber, Phone, Plocation) - project details",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.472,
        0.4160642424242424,
        0.622,
        0.5848642424242425
      ],
      "text": "- 3NF (Third Normal Form)\n  - transitive dependency\n  - e.g. A \u2192 B, B \u2192 C\n    - C is transitively dependent on A via B\n  - already 2NF\n  - no nonprime attr is transitively dependent on PK",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.472,
        0.588700606060606,
        0.622,
        0.6731006060606061
      ],
      "text": "For 2NF \u2192 3NF\n  - find transitive deps\n  - move T.D attrs to new relation along with copy of intermediate determinant (CD)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.732,
        0.3508460606060606,
        0.882,
        0.4122278787878788
      ],
      "text": "e.g. EMP-DEPT (Ename, SSN, Date, Addr, Dnumber, Dname, Dmgr, SSN) FD chain: SSN \u2192 Dnumber Dnumber \u2192 Dname, Dmgr, SSN (creates T.D)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.732,
        0.4160642424242424,
        0.882,
        0.5081369696969696
      ],
      "text": "ED1 (Ename, SSN, Date, Address, Dnumber) ED2 (Dnumber, Dname, Dmgr, SSN)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.732,
        0.5119733333333334,
        0.882,
        0.6731006060606061
      ],
      "text": "\u2192 LHS of F.D - determinant: look at F.D set - to determine if LHS is superkey - compute attribute closure",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.9219999999999999,
        0.3508460606060606,
        0.9989999999999999,
        0.4122278787878788
      ],
      "text": "(SSN alone determines Ename)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.9219999999999999,
        0.4160642424242424,
        0.9989999999999999,
        0.6731006060606061
      ],
      "text": "- for 2NF \u2192 3NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.012,
        0.6781672727272728,
        0.224,
        0.7029236363636364
      ],
      "text": "- BCNF (Boyce-Codd Normal Form)\n  - stricter version of 3NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.127,
        0.7136872727272727,
        0.224,
        0.7746812121212121
      ],
      "text": "> why I normalize to 3NF > does it always normalize > to BCNF?",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.127,
        0.7793454545454546,
        0.224,
        0.7997963636363636
      ],
      "text": "- if BCNF, no redundancies",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.127,
        0.8033842424242424,
        0.224,
        0.8643781818181818
      ],
      "text": "e.g. for $X \\rightarrow Y$ $X$ is the determinant > other thing doing the > \"determining\"",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.127,
        0.8679660606060606,
        0.224,
        0.9253721212121212
      ],
      "text": "- for every $X \\rightarrow Y$ in $R$ , $X$ must > be superkey (uniquely identify > every row)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.127,
        0.9289600000000001,
        0.224,
        0.9899539393939394
      ],
      "text": "- vs. 3NF\n  - 3NF says non-superkey determinant > is okay as long as what > it determines ( $Y$ ) is part of > some C/L (i.e. prime attr)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.6781672727272728,
        0.47400000000000003,
        0.7029236363636364
      ],
      "text": "Ev. 1",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.7065115151515151,
        0.55,
        0.7639175757575757
      ],
      "text": "$\\Rightarrow$ Prime Attrs\n  - Property#\n  - County-name\n  - Lot#",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.7675054545454546,
        0.55,
        0.7997963636363636
      ],
      "text": "- already INF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.8033842424242424,
        0.55,
        0.8356751515151515
      ],
      "text": "- for INF $\\rightarrow$ 2NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.8392630303030304,
        0.55,
        0.8715539393939394
      ],
      "text": "FD2: PID $\\rightarrow$ all other attr FD3: County-name $\\rightarrow$ Tax-rate FD4: Area $\\rightarrow$ Price",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.8751418181818181,
        0.47400000000000003,
        0.9002569696969697
      ],
      "text": "2NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.45200000000000007,
        0.9038448484848485,
        0.55,
        0.9576630303030303
      ],
      "text": "\u2460 PID#, CN, Lot#, Area, Price \u2461 CN, Tax-rate",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.587,
        0.6781672727272728,
        0.685,
        0.7029236363636364
      ],
      "text": "Non prime Attrs\n  - Area\n  - Price\n  - Tax-rate",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.587,
        0.7065115151515151,
        0.685,
        0.7639175757575757
      ],
      "text": "- for 2NF $\\rightarrow$ 3NF\n  - Area, Price are NP",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.587,
        0.7675054545454546,
        0.685,
        0.7997963636363636
      ],
      "text": "\u2462 Area, Price \u2460 PID#, County-name, Lot#, Area",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.587,
        0.8033842424242424,
        0.685,
        0.8356751515151515
      ],
      "text": "- verifying BCNF (W)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.724,
        0.6781672727272728,
        0.746,
        0.7029236363636364
      ],
      "text": "Ev. 2: P#, Id, Lt, Pa, Co, S#, Sn, CR",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.724,
        0.7065115151515151,
        0.746,
        0.7639175757575757
      ],
      "text": "Prime Non prime\n  - P# - PA\n  - Id - Co\n  - Lt - S#\n  - CR - Sn",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.724,
        0.7675054545454546,
        0.746,
        0.7997963636363636
      ],
      "text": "- already INF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.724,
        0.8033842424242424,
        0.746,
        0.8356751515151515
      ],
      "text": "$\\left\\{ \\begin{array}{l} \\text{required for} \\\\ \\text{INF} \\end{array} \\right.$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.587,
        0.8392630303030304,
        0.685,
        0.8715539393939394
      ],
      "text": "$\\text{TD}$",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.587,
        0.8751418181818181,
        0.685,
        0.9253721212121212
      ],
      "text": "$\\text{Independent on PID\\#}$",
      "page_index": 1,
