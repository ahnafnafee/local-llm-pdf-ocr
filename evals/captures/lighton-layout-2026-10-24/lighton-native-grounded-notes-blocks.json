      "label": "list"
    },
    {
      "bbox": [
        0.102,
        0.077,
        0.612,
        0.124
      ],
      "text": "$\\delta_{C1d.1} = C1d.2 \\ (Climbs \\times Climbers)$",
      "page_index": 13,
      "label": "formula"
    },
    {
      "bbox": [
        0.094,
        0.133,
        0.527,
        0.183
      ],
      "text": "*In general, very expensive...*",
      "page_index": 13,
      "label": "text"
    },
    {
      "bbox": [
        0.088,
        0.19799999999999998,
        0.417,
        0.23300000000000004
      ],
      "text": "Use JOIN instead",
      "page_index": 13,
      "label": "text"
    },
    {
      "bbox": [
        0.047,
        0.253,
        0.358,
        0.296
      ],
      "text": "- (THETA) JOIN",
      "page_index": 13,
      "label": "list"
    },
    {
      "bbox": [
        0.125,
        0.309,
        0.458,
        0.346
      ],
      "text": "- Join of two relations",
      "page_index": 13,
      "label": "list"
    },
    {
      "bbox": [
        0.264,
        0.361,
        0.628,
        0.411
      ],
      "text": "$R \\bowtie_c S = \\delta_c (R \\times S)$",
      "page_index": 13,
      "label": "formula"
    },
    {
      "bbox": [
        0.314,
        0.4139999999999999,
        0.875,
        0.448
      ],
      "text": "$\\rightarrow c$ is called a JOIN condition",
      "page_index": 13,
      "label": "text"
    },
    {
      "bbox": [
        0.314,
        0.4610000000000001,
        0.552,
        0.529
      ],
      "text": "\u2014 usually using full constraint.",
      "page_index": 13,
      "label": "text"
    },
    {
      "bbox": [
        0.684,
        0.448,
        0.9240000000000002,
        0.544
      ],
      "text": "$\\rightarrow$ can only have attribute name",
      "page_index": 13,
      "label": "text"
    },
    {
      "bbox": [
        0.648,
        0.54,
        0.89,
        0.642
      ],
      "text": "*this is different from SELECTION condition*",
      "page_index": 13,
      "label": "text"
    },
    {
      "bbox": [
        0.227,
        0.6289999999999999,
        0.681,
        0.69
      ],
      "text": "$Climbs \\bowtie (C1d.1 = C1d.2) Climbers$",
