    },
    {
      "bbox": [
        0.036,
        0.083,
        0.309,
        0.12199999999999998
      ],
      "text": "## Relational Algebra",
      "page_index": 9,
      "label": "title"
    },
    {
      "bbox": [
        0.056,
        0.133,
        0.814,
        0.257
      ],
      "text": "- $\\sigma$ used to select tuples\n  - selecting tuples from relation $R$ that satisfy selection condition $C$",
      "page_index": 9,
      "label": "list"
    },
    {
      "bbox": [
        0.313,
        0.274,
        0.453,
        0.32200000000000006
      ],
      "text": "$\\sigma_C(R)$",
      "page_index": 9,
      "label": "formula"
    },
    {
      "bbox": [
        0.062,
        0.34,
        0.65,
        0.38700000000000007
      ],
      "text": "*String constant written in single quotes*",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.073,
        0.4,
        0.127,
        0.437
      ],
      "text": "e.g.",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.152,
        0.427,
        0.726,
        0.4739999999999999
      ],
      "text": "$\\sigma(\\text{Dno}=4 \\text{ AND } \\text{Salary}>25000) \\text{ OR } (\\text{Dno}=5 \\text{ AND } \\text{Salary}>30000)$",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.073,
        0.49,
        0.426,
        0.531
      ],
      "text": "- NOT > AND > OR \u2014 Precedence",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.056,
        0.546,
        0.366,
        0.587
      ],
      "text": "- $\\sigma$ is commutative",
      "page_index": 9,
      "label": "list"
    },
    {
      "bbox": [
        0.045,
        0.633,
        0.69,
        0.688
      ],
      "text": "- Project used to SELECT attributes",
      "page_index": 9,
      "label": "list"
    },
    {
      "bbox": [
        0.181,
        0.692,
        0.378,
        0.74
      ],
      "text": "$\\pi_L(R)$",
      "page_index": 9,
      "label": "formula"
    },
    {
      "bbox": [
        0.382,
        0.744,
        0.626,
        0.79
      ],
      "text": "$\\leftarrow$ list of attributes",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.112,
        0.8,
        0.403,
        0.853
      ],
      "text": "$\\pi_{\\text{rid}, \\text{height}}(\\text{Players})$",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.247,
        0.857,
        0.745,
        0.9069999999999999
      ],
      "text": "$\\rightarrow$ basically filtering by columns",
      "page_index": 9,
      "label": "text"
    },
    {
      "bbox": [
        0.056,
        0.011,
        0.918,
        0.101
      ],
      "text": "- in 'pure' relational algebra, selections should be sets, so no duplicates",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.118,
        0.103,
        0.72,
        0.157
      ],
      "text": "- But in SQL, it's a multiset",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.036,
        0.164,
        0.612,
        0.224
      ],
      "text": "- $\\pi$ is unary, not commutative",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.187,
        0.253,
        0.652,
        0.32
      ],
      "text": "$\\pi_{name, age} (6 \\text{ ages}, 30 \\text{ climbers})$",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.154,
        0.333,
        0.753,
        0.427
      ],
      "text": "$\\downarrow$\n\nSELECT name, age FROM CLIMBERS WHERE age > 30",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.12,
        0.462,
        0.8860000000000001,
        0.55
      ],
      "text": "- usually we apply the filter first and then project attributes",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.028,
        0.568,
        0.8380000000000001,
        0.668
      ],
      "text": "Do we need to check union compatibility for Cartesian product?",
      "page_index": 10,
      "label": "text"
    },
    {
      "bbox": [
        0.067,
        0.648,
        0.94,
        0.757
      ],
      "text": "- No, since it already returns all list of combination uniquely",
      "page_index": 10,
      "label": "text"
    },
