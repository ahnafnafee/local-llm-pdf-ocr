      "label": "formula"
    },
    {
      "bbox": [
        0.094,
        0.64,
        0.284,
        0.707
      ],
      "text": "### \u2461 merge-relation",
      "page_index": 0,
      "label": "title"
    },
    {
      "bbox": [
        0.064,
        0.794,
        0.308,
        0.957
      ],
      "text": "F.U applies to second case as well Cross Ref can also apply here",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.577,
        0.82,
        0.822,
        0.8660000000000001
      ],
      "text": "P.U can be either one",
