        0.329,
        0.4,
        0.376,
        0.427
      ],
      "text": "total",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.707,
        0.324,
        0.9219999999999999,
        0.4139999999999999
      ],
      "text": "Cross Ref also applies here",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.68,
        0.42,
        0.9219999999999999,
        0.524
      ],
      "text": "merge-rel can work here with P.U from total participation - not desirable",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.3,
        0.574,
        0.9219999999999999,
        0.624
      ],
      "text": "$$\nS \\mid \\underline{PK(S)} \\mid \\ldots \\mid PK(T) \\mid a_1 \\mid \\ldots \\mid a_n\n$$",
