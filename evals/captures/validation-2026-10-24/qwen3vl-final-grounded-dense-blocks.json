{
  "blocks": [
    {
      "bbox": [
        0.018,
        0.01,
        0.349,
        0.036
      ],
      "text": "SQL - Application Code",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.025,
        0.034,
        0.377,
        0.052
      ],
      "text": "- Two main integration approaches",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.032,
        0.051,
        0.37,
        0.069
      ],
      "text": "- SQL (lower level interface) -> embedded SQL",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.032,
        0.068,
        0.35,
        0.08400000000000002
      ],
      "text": "- ODBC - special API to -> ODBC",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.037,
        0.081,
        0.357,
        0.09899999999999999
      ],
      "text": "SQL commands",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.023,
        0.1,
        0.355,
        0.116
      ],
      "text": "Example: SELECT SUM(grade) FROM student WHERE grade > 60",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.041,
        0.118,
        0.357,
        0.132
      ],
      "text": "Yes No Yes No",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.037,
        0.137,
        0.355,
        0.15
      ],
      "text": "No No Yes No",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.046,
        0.155,
        0.359,
        0.16800000000000004
      ],
      "text": "lower lower",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.018,
        0.174,
        0.363,
        0.19
      ],
      "text": "- Source of DB not be known at time program is written for embedded SQL",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.025,
        0.194,
        0.363,
        0.20699999999999996
      ],
      "text": "-> can get it at runtime instead of compile time",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.018,
        0.217,
        0.349,
        0.234
      ],
      "text": "- SQLSTATE - common error code defined here",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.032,
        0.236,
        0.355,
        0.25
      ],
      "text": "EXEC SQL SELECT SUM(grade) FROM student WHERE grade > 60",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.041,
        0.251,
        0.357,
        0.267
      ],
      "text": "INTO :sum, :count, :avg;",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.048,
        0.269,
        0.357,
        0.283
      ],
      "text": "FROM student;",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.041,
        0.284,
        0.35,
        0.299
      ],
      "text": "WHERE grade > 60;",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.016,
        0.302,
        0.37,
        0.319
      ],
      "text": "- for db, start index from 1",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.018,
        0.324,
        0.357,
        0.34
      ],
      "text": "Project -",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.025,
        0.343,
        0.363,
        0.35900000000000004
      ],
      "text": "- need to use LIKE for partial matching",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.018,
        0.362,
        0.357,
        0.376
      ],
      "text": "- open-close ?",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.018,
        0.38,
        0.349,
        0.394
      ],
      "text": "- program should NOT crash",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.023,
        0.399,
        0.357,
        0.4139999999999999
      ],
      "text": "- use grade for simplicity (use that I know best)",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.006805454545454545,
        0.256,
        0.017192727272727273
      ],
      "text": "- for example:",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.017192727272727273,
        0.256,
        0.02686363636363636
      ],
      "text": "R = (A,B,C,D,E,G)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.02686363636363636,
        0.256,
        0.03725090909090909
      ],
      "text": "FDs: AB\u2192C, BC\u2192AD, D\u2192E, CE\u2192B",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.03725090909090909,
        0.256,
        0.04763818181818182
      ],
      "text": "\u2234 {A,B}\u207a ?",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.06124909090909091,
        0.229,
        0.07163636363636364
      ],
      "text": "- build a snowball...",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.23,
        0.07378545454545454,
        0.284,
        0.08417272727272727
      ],
      "text": "Snowball",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.07378545454545454,
        0.229,
        0.08417272727272727
      ],
      "text": "Round",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.08417272727272727,
        0.229,
        0.09456
      ],
      "text": "Start | A and B",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.09456,
        0.229,
        0.10494727272727272
      ],
      "text": "1 | AB\u2192C | {A,B}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.10494727272727272,
        0.229,
        0.11533454545454545
      ],
      "text": "2 | BC\u2192AD | {A,B,C,D}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.11533454545454545,
        0.229,
        0.12572181818181816
      ],
      "text": "3 | D\u2192E | {A,B,C,D,E}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.12572181818181816,
        0.229,
        0.13610909090909093
      ],
      "text": "4 | X",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.23,
        0.13610909090909093,
        0.284,
        0.14649636363636362
      ],
      "text": "Done",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.14936181818181818,
        0.256,
        0.15974909090909092
      ],
      "text": "\u2234 {A,B}\u207a = {A,B,C,D,E}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.013,
        0.15974909090909092,
        0.256,
        0.1701363636363636
      ],
      "text": "G not need readdude",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.006805454545454545,
        0.584,
        0.017192727272727273
      ],
      "text": "- what about: {C,D}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.017192727272727273,
        0.584,
        0.02686363636363636
      ],
      "text": "{C,D}\u207a \u2192 {C,D}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.02686363636363636,
        0.584,
        0.03725090909090909
      ],
      "text": "D\u2192E \u2192 {C,D,E}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.03725090909090909,
        0.584,
        0.04763818181818182
      ],
      "text": "(E\u2192B \u2192 {C,D,E,B}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.04763818181818182,
        0.584,
        0.05802545454545455
      ],
      "text": "BC\u2192A \u2192 {A,B,C,D,E}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.05802545454545455,
        0.584,
        0.06841272727272728
      ],
      "text": "G still missing",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.06841272727272728,
        0.584,
        0.07880000000000001
      ],
      "text": "\u2234 {C,D}\u207a is NOT a candidate key",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.07880000000000001,
        0.584,
        0.08918727272727273
      ],
      "text": "\u2192 {C,D,G}\u207a = {A,B,C,D,E,G}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.08918727272727273,
        0.584,
        0.09957454545454546
      ],
      "text": "G is a superkey since it covers all attributes in R",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.09957454545454546,
        0.584,
        0.10996181818181817
      ],
      "text": "G is a candidate key too since is minimal - removing G breaks the S.U. property",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.398,
        0.10996181818181817,
        0.584,
        0.12034909090909092
      ],
      "text": "same applies for: {A,B,G}\u207a",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.006805454545454545,
        0.8560000000000001,
        0.017192727272727273
      ],
      "text": "Normalization",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.017192727272727273,
        0.8560000000000001,
        0.02686363636363636
      ],
      "text": "- INF: disallows multivalue attributes, composite attrs, and their combinations",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.02686363636363636,
        0.8560000000000001,
        0.03725090909090909
      ],
      "text": "- Prime vs. Nonprime Atts",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.03725090909090909,
        0.8560000000000001,
        0.04763818181818182
      ],
      "text": "Members of any candidate key \u2192 not a prime attr (not a member of any candidate key)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.04763818181818182,
        0.8560000000000001,
        0.05802545454545455
      ],
      "text": "disjoint",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.06841272727272728,
        0.8560000000000001,
        0.07880000000000001
      ],
      "text": "- Full FD vs. Partial FD",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.07880000000000001,
        0.8560000000000001,
        0.08918727272727273
      ],
      "text": "By removing a single attr breaks the dependency",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.08918727272727273,
        0.8560000000000001,
        0.09957454545454546
      ],
      "text": "By removing some attrs and dep still holds",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.09957454545454546,
        0.8560000000000001,
        0.10996181818181817
      ],
      "text": "e.g. EMP-PROJ(SSN,Phnber,Hours,Grade)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.10996181818181817,
        0.8560000000000001,
        0.12034909090909092
      ],
      "text": "{SSN,Phnber}\u2192Hours : full FD",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.12034909090909092,
        0.8560000000000001,
        0.13073636363636365
      ],
      "text": "(need both to obtain Hours value)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.13073636363636365,
        0.8560000000000001,
        0.14112363636363637
      ],
      "text": "{SSN,Phnber}\u2192Grade : partial FD",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.661,
        0.14112363636363637,
        0.8560000000000001,
        0.15151090909090908
      ],
      "text": "(SSN alone determines Grade)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.01,
        0.33972060606060606,
        0.256,
        0.3612042424242424
      ],
      "text": "- 2NF (Second Normal Form)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.074,
        0.363889696969697,
        0.227,
        0.38230424242424244
      ],
      "text": "\u2192 already in 1NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.085,
        0.38192060606060607,
        0.303,
        0.4026369696969697
      ],
      "text": "\u2192 every nonprime attr is fully FD",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.086,
        0.3995678787878788,
        0.223,
        0.4160642424242424
      ],
      "text": "on primary key",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.041,
        0.4172151515151515,
        0.176,
        0.43601333333333336
      ],
      "text": "\u2234 for 1NF \u2192 2NF",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.07,
        0.4379315151515151,
        0.255,
        0.4590315151515152
      ],
      "text": "- find every partial dependencies",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.08,
        0.4559624242424242,
        0.266,
        0.4755278787878788
      ],
      "text": "- move attr and partial key",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.104,
        0.47476060606060605,
        0.269,
        0.49087333333333333
      ],
      "text": "to new, separate relation",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.058,
        0.49087333333333333,
        0.32,
        0.5046842424242425
      ],
      "text": "as partial dependencies cause redundancies",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.038,
        0.5108224242424242,
        0.346,
        0.5257842424242424
      ],
      "text": "eg. EMP_PROJ(SSN, Pnum, Hours, Ena, Dname, Plocation)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.038,
        0.5265515151515151,
        0.301,
        0.5395951515151515
      ],
      "text": "FD1: {SSN, Pnumber} \u2192 Hours (full)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.038,
        0.5399787878787878,
        0.297,
        0.5557078787878788
      ],
      "text": "FD2: SSN \u2192 Ena (partial)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.076,
        0.5564751515151515,
        0.257,
        0.5714369696969698
      ],
      "text": "- ename depends",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.1,
        0.5699024242424243,
        0.269,
        0.5833296969696969
      ],
      "text": "only on SSN",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.074,
        0.5825624242424243,
        0.315,
        0.5982915151515151
      ],
      "text": "FD3: Pnumber \u2192 Hours, Plocation (partial)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.10600000000000001,
        0.5979078787878788,
        0.308,
        0.6121024242424242
      ],
      "text": "- key dependency",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.174,
        0.6109515151515151,
        0.275,
        0.6239951515151516
      ],
      "text": "on Pnumber.",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.4,
        0.3485442424242424,
        0.635,
        0.3677260606060606
      ],
      "text": "After 2NF \u2192 3 NF above",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.397,
        0.36849333333333334,
        0.635,
        0.3857569696969697
      ],
      "text": "EP1 (SSN, Pnumber, Hours) - full dep",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.394,
        0.3861406060606061,
        0.633,
        0.40417151515151517
      ],
      "text": "EP2 (SSN, Ena) - employee details",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.393,
        0.40417151515151517,
        0.638,
        0.42373696969696967
      ],
      "text": "EP3 (Pnumber, Pname, Plocation) - project details",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.4,
        0.43332787878787876,
        0.63,
        0.45135878787878786
      ],
      "text": "- 3NF (Third Normal Form)",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.408,
        0.4517424242424242,
        0.609,
        0.46747151515151514
      ],
      "text": "- transitive dependency",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.412,
        0.4670878787878788,
        0.638,
        0.4843515151515152
      ],
      "text": "eg. A \u2192 B, B \u2192 C",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.47,
        0.4839678787878788,
        0.638,
        0.5019987878787879
      ],
      "text": "C is transitively dependent",
      "page_index": 1,
      "label": "text"
    },
    {
      "bbox": [
        0.49699999999999994,
        0.4985460606060606,
        0.601,
        0.5135078787878788
