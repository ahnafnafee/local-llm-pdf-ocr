    },
    {
      "bbox": [
        0.435,
        0.534,
        0.646,
        0.552
      ],
      "text": "L16: Decomposition Algorithms",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.01,
        0.93,
        0.028
      ],
      "text": "- to make any changes, I need to declare a sensitive cursor",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.028,
        0.93,
        0.046000000000000006
      ],
      "text": "- embedded SQL recommended in systems that require high performance without JDBC overhead",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.056999999999999995,
        0.93,
        0.075
      ],
      "text": "- for dynamic SQL, we cannot reuse, since we need to prepare",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.083,
        0.93,
        0.101
      ],
      "text": "JDBC/ODBC",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.101,
        0.93,
        0.119
      ],
      "text": "JDBC does not require knowing dbinfo or schema info",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.128,
        0.93,
        0.147
      ],
      "text": "- can connect to multiple DBs with multiple separate drivers",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.147,
        0.93,
        0.165
      ],
      "text": "- all interactions with the DB performed via a connection object",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.181,
        0.93,
        0.199
      ],
      "text": "Prepared Statement is more efficient to use since its made to reuse as it is precompiled",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.199,
        0.835,
        0.218
      ],
      "text": "- ? are placeholders",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.245,
        0.93,
        0.264
      ],
      "text": "- Keywon -> Redundancy",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.264,
        0.93,
        0.282
      ],
      "text": "- FD: most important kind of constraint in the relational model",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.282,
        0.93,
        0.301
      ],
      "text": "- associated with the schema, not the instance",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.318,
        0.93,
        0.3360000000000001
      ],
      "text": "- can I represent key constraint using FD?",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.353,
        0.93,
        0.371
      ],
      "text": "X -> Y",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.371,
        0.93,
        0.389
      ],
      "text": "X functionally determines Y",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.389,
        0.93,
        0.408
      ],
      "text": "alternatively,",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.408,
        0.93,
        0.426
      ],
      "text": "y is dependent on x",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.443,
        0.93,
        0.4610000000000001
      ],
      "text": "Phonebook",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.4610000000000001,
        0.93,
        0.48
      ],
      "text": "phone # Name City",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.48,
        0.93,
        0.49800000000000005
      ],
      "text": "if I know someone's phone no,",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.49800000000000005,
        0.93,
        0.516
      ],
      "text": "can I always figure out their name",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.709,
        0.516,
        0.93,
        0.534
      ],
      "text": "Phone # -> Name",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.589,
        0.29,
        0.607
      ],
      "text": "- look out for redundancies in data instances",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.607,
        0.435,
        0.626
      ],
      "text": "t1[X] = t2[X] => t1[Y] < t2[Y]",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.626,
        0.435,
        0.6440000000000001
      ],
      "text": "t1 and t2 -> Any two rows in your table",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.6440000000000001,
        0.435,
        0.663
      ],
      "text": "t1[X] -> look at the X columns of row 1",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.663,
        0.435,
        0.681
      ],
      "text": "t1(X)=t2(X)->row 1 and row 2 have same X values",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.699,
        0.435,
        0.7180000000000001
      ],
      "text": "-> forces",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.7180000000000001,
        0.435,
        0.7360000000000001
      ],
      "text": "t1(Y)=t2(Y)->row 1 and row 2 must also have some Y value",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.7539999999999999,
        0.382,
        0.773
      ],
      "text": "FD between non-key attributes is a RED FLAG that data is being repeatedly unnecessarily",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.79,
        0.435,
        0.808
      ],
      "text": "- FD means one attr's value is completely controlled by another - when controlling attr appears in multiple rows, its dependent value gets copied",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.825,
        0.308,
        0.844
      ],
      "text": "- why repetition is problematic",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.76,
        0.043,
        0.8939999999999999,
        0.102
      ],
      "text": "Consider a relation R with five attributes ABCDE. You are given the following dependencies: A\u2192B, BC\u2192E, and ED\u2192A.",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.763,
        0.105,
        0.8939999999999999,
        0.12100000000000001
      ],
      "text": "a) List all candidate keys for R",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.762,
        0.123,
        0.8939999999999999,
        0.139
      ],
      "text": "b) Is R in 3NF?",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.762,
        0.14,
        0.8939999999999999,
        0.156
      ],
      "text": "c) Is R in BCNF?",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.76,
        0.16,
        0.8939999999999999,
        0.202
      ],
      "text": "Suppose that we have the following three tuples in a legal instance of a relation schema S with three attributes ABC (listed in order): (1, 2, 3), (4, 2, 3), and (5, 3, 3).",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.76,
        0.204,
        0.8939999999999999,
        0.217
      ],
      "text": "a) Which of the following dependencies can you infer does not hold over schema S?",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.76,
        0.22,
        0.8939999999999999,
        0.23300000000000004
      ],
      "text": "A\u2192B, BC\u2192A, B\u2192C",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.76,
        0.235,
        0.8939999999999999,
        0.251
      ],
      "text": "b) Can you identify any dependencies that hold over S?",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.761,
        0.254,
        0.893,
        0.29
      ],
      "text": "Suppose you are given a relation R with four attributes, ABCD. For the following sets of FDs: C\u2192D, C\u2192A, B\u2192C, assuming those are the only dependencies that hold for R.",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.761,
        0.293,
        0.8939999999999999,
        0.307
      ],
      "text": "a) Identify the candidate key(s) for R",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.76,
        0.31,
        0.8939999999999999,
        0.325
      ],
      "text": "b) Identify the best normal form that R satisfies (1NF, 2NF, 3NF, or BCNF).",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.365,
        0.8939999999999999,
        0.38199999999999995
      ],
      "text": "1 R{A, B, CD, E} S",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.383,
        0.775,
        0.39599999999999996
      ],
      "text": "FD1: A\u2192B",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.399,
        0.775,
        0.412
      ],
      "text": "FD2: BC\u2192E",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.416,
        0.775,
        0.429
      ],
      "text": "FD3: ED\u2192A",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.432,
        0.81,
        0.4610000000000001
      ],
      "text": "Utilize Attr. Closure",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.462,
        0.8939999999999999,
        0.533
      ],
      "text": "RHS: {A, B, E} ... not included",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.561,
        0.794,
        0.574
      ],
      "text": "b) All attrs are prime",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.576,
        0.736,
        0.589
      ],
      "text": ": already in BNF",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.591,
        0.736,
        0.604
      ],
      "text": "c) No,",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.606,
        0.736,
        0.619
      ],
      "text": "A\u2192B",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.6210000000000001,
        0.775,
        0.6339999999999999
      ],
      "text": ": not a superkey",
      "page_index": 2,
      "label": "text"
    },
    {
      "bbox": [
        0.708,
        0.636,
        0.775,
        0.6490000000000001
