    },
    {
      "bbox": [
        0.006,
        0.4610000000000001,
        0.435,
        0.48
      ],
      "text": "- program should NOT crash",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.006,
        0.49800000000000005,
        0.308,
        0.517
      ],
      "text": "- use grep for simplicity (ez that's what I know best)",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.01,
        0.646,
        0.031
      ],
      "text": "- Impedance Mismatch problem",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.031,
        0.646,
        0.049
      ],
      "text": "- fixed with cursor",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.056999999999999995,
        0.646,
        0.075
      ],
      "text": "OPEN: when SQL statement is executed",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.075,
        0.646,
        0.094
      ],
      "text": "FETCH: when it moves to the next row",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.101,
        0.728,
        0.119
      ],
      "text": "INSENSITIVE cursor: cannot make changes to DB with cursor.",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.119,
        0.646,
        0.138
      ],
      "text": "If I want to update result, then declare sensitive cursor",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.138,
        0.646,
        0.156
      ],
      "text": "Gives issue with collecting set of tuples",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.173,
        0.646,
        0.192
      ],
      "text": "CLOSE: closes the cursor",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.192,
        0.646,
        0.21
      ],
      "text": "cursor can be reopened when in variable is different",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.227,
        0.646,
        0.245
      ],
      "text": "note the poll!!",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.245,
        0.646,
        0.264
      ],
      "text": "execute update () only returns number of rows (affected)",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.271,
        0.646,
        0.29
      ],
      "text": "see the comparison table for G so use executeQuery() instead",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.307,
        0.646,
        0.325
      ],
      "text": "- JDBC vs SQLs",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.325,
        0.646,
        0.344
      ],
      "text": "for managing complexity better",
      "page_index": 0,
      "label": "text"
    },
    {
      "bbox": [
        0.435,
        0.36,
        0.646,
        0.379
      ],
